modules = ["web", "python-base-3.13", "java-graalvm22.3", "postgresql-16", "nodejs-24"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["actionlint", "alsa-lib", "at-spi2-atk", "at-spi2-core", "atk", "dbus", "freetype", "glib", "gumbo", "harfbuzz", "jbig2dec", "libdrm", "libjpeg_turbo", "libxkbcommon", "mesa", "mupdf", "nspr", "nss", "openjpeg", "shellcheck", "swig", "xcbuild", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "android-tools", "clamav", "fetchutils"]

[[ports]]
localPort = 3000
externalPort = 5000

[[ports]]
localPort = 4173
externalPort = 5173
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5101
externalPort = 6000

[[ports]]
localPort = 18443
externalPort = 3001

[[ports]]
localPort = 18853
externalPort = 3000

[[ports]]
localPort = 28080
externalPort = 4200

[[ports]]
localPort = 28443
externalPort = 3003

[[ports]]
localPort = 28853
externalPort = 3002

[env]
PORT = "5000"
CLAMAV_LOCAL_MODE = "true"
CLAMAV_LOCAL_PORT = "3310"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"


[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Headplane"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run headplane:dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[agent]
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
SAFE_NET_CALL_CONTROL_BASE_URL = "https://api.callcontrol.com/api/2015-11-01/Reputation"
SAFE_NET_CALL_REPUTATION_PROVIDER = "call-control"
SAFE_NET_CALL_CONTROL_PROTECT_BASE_URL = "https://api.callcontrol.com/api/2015-11-01/Enterprise/ShouldBlock"
REVENUECAT_ENTITLEMENT_IDENTIFIER = "premium"
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "appb8046f5b77"
REVENUECAT_PROJECT_ID = "proj7f56aa4c"
REVENUECAT_TEST_STORE_APP_ID = "app8db4007cbf"
VITE_REVENUECAT_ANDROID_API_KEY = "goog_vNwVRcGyaghjdJGUKXWkDiZSowK"
