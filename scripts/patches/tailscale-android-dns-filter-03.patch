+__TAB__}
+__TAB__replySource := netip.AddrFrom4([4]byte{packet[12], packet[13], packet[14], packet[15]})
+__TAB__replyDestination := netip.AddrFrom4([4]byte{packet[16], packet[17], packet[18], packet[19]})
+__TAB__if replySource != info.destination || replyDestination != info.source {
+__TAB____TAB__t.Fatalf("reply addresses = %s -> %s, want %s -> %s", replySource, replyDestination, info.destination, info.source)
+__TAB__}
+__TAB__if gotSourcePort := binary.BigEndian.Uint16(packet[20:22]); gotSourcePort != dnsPort {
+__TAB____TAB__t.Fatalf("reply source port = %d, want 53", gotSourcePort)
+__TAB__}
+__TAB__if gotDestinationPort := binary.BigEndian.Uint16(packet[22:24]); gotDestinationPort != info.sourcePort {
