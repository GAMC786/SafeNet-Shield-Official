+__TAB____TAB__t.Fatalf("DNS response code = %d, want REFUSED (5)", binary.BigEndian.Uint16(response[2:4])&0x000f)
+__TAB__}
+__TAB__packet := buildDNSReplyPacket(info, response)
+__TAB__if len(packet) == 0 {
