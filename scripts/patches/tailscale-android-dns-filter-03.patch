+func checksum(data []byte) uint16 {
+__TAB__var sum uint32
+__TAB__for len(data) >= 2 {
+__TAB____TAB__sum += uint32(binary.BigEndian.Uint16(data[:2]))
+__TAB____TAB__data = data[2:]
+__TAB__}
+__TAB__if len(data) == 1 {
+__TAB____TAB__sum += uint32(data[0]) << 8
+__TAB__}
+__TAB__for sum>>16 != 0 {
+__TAB____TAB__sum = (sum & 0xffff) + (sum >> 16)
+__TAB__}
+__TAB__return ^uint16(sum)
+}
+
+func udpChecksumIPv4(source, destination, udp []byte) uint16 {
+__TAB__pseudo := make([]byte, 12+len(udp))
+__TAB__copy(pseudo[0:4], source)
+__TAB__copy(pseudo[4:8], destination)
+__TAB__pseudo[9] = ipProtocolUDP
+__TAB__binary.BigEndian.PutUint16(pseudo[10:12], uint16(len(udp)))
+__TAB__copy(pseudo[12:], udp)
+__TAB__value := checksum(pseudo)
+__TAB__if value == 0 {
+__TAB____TAB__return 0xffff
+__TAB__}
+__TAB__return value
+}
+
+func udpChecksumIPv6(source, destination, udp []byte) uint16 {
+__TAB__pseudo := make([]byte, 40+len(udp))
+__TAB__copy(pseudo[0:16], source)
+__TAB__copy(pseudo[16:32], destination)
+__TAB__binary.BigEndian.PutUint32(pseudo[32:36], uint32(len(udp)))
+__TAB__pseudo[39] = ipProtocolUDP
+__TAB__copy(pseudo[40:], udp)
+__TAB__value := checksum(pseudo)
+__TAB__if value == 0 {
+__TAB____TAB__return 0xffff
+__TAB__}
+__TAB__return value
+}
