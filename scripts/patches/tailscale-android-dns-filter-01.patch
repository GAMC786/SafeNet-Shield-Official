new file mode 100644
index 0000000..e8212d5
--- /dev/null
+++ b/libtailscale/dnsfilter.go
@@ -0,0 +1,370 @@
+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package libtailscale
+
+import (
+__TAB__"encoding/binary"
+__TAB__"log"
+__TAB__"net/netip"
+
+__TAB__"github.com/tailscale/wireguard-go/tun"
+)
+
+const (
+__TAB__ipProtocolTCP = 6
+__TAB__ipProtocolUDP = 17
+__TAB__dnsPort       = 53
+)
+
+type dnsPacketInfo struct {
+__TAB__source          netip.Addr
+__TAB__destination     netip.Addr
+__TAB__sourcePort      uint16
+__TAB__destinationPort uint16
+__TAB__query           []byte
+__TAB__isTCP           bool
+__TAB__fragmented      bool
+__TAB__ipVersion       int
+}
+
+// filterTailscalePackets applies DNS and non-DNS firewall policy at the TUN
+// packet boundary, returning REFUSED replies for blocked, unfragmented UDP queries.
+func (d *multiTUN) filterTailscalePackets(dev *tunDevice, slab []byte, packets []tun.ReadPacket, count int) int {
+__TAB__if count <= 0 {
+__TAB____TAB__return 0
+__TAB__}
+__TAB__if count > len(packets) {
+__TAB____TAB__count = len(packets)
+__TAB__}
+__TAB__if d.appCtx == nil {
+__TAB____TAB__return count
+__TAB__}
+__TAB__kept := 0
+__TAB__for index := 0; index < count; index++ {
+__TAB____TAB__packet := packets[index]
+__TAB____TAB__if packet.Offset < 0 || packet.Size < 0 ||
+__TAB____TAB____TAB__packet.Offset > len(slab) || packet.Size > len(slab)-packet.Offset {
+__TAB____TAB____TAB__if d.appCtx.ShouldBlockNonDNSPacket() {
+__TAB____TAB____TAB____TAB__continue
+__TAB____TAB____TAB__}
+__TAB____TAB____TAB__packets[kept] = packet
+__TAB____TAB____TAB__kept++
+__TAB____TAB____TAB__continue
+__TAB____TAB__}
+__TAB____TAB__raw := slab[packet.Offset : packet.Offset+packet.Size]
+__TAB____TAB__info, ok := parseDNSPacket(raw)
+__TAB____TAB__if !ok {
+__TAB____TAB____TAB__if d.appCtx.ShouldBlockNonDNSPacket() {
+__TAB____TAB____TAB____TAB__continue
+__TAB____TAB____TAB__}
+__TAB____TAB____TAB__packets[kept] = packet
+__TAB____TAB____TAB__kept++
+__TAB____TAB____TAB__continue
+__TAB____TAB__}
+
+__TAB____TAB__block := d.appCtx.ShouldBlockDNSPacket(
+__TAB____TAB____TAB__info.query,
+__TAB____TAB____TAB__info.source.String(),
+__TAB____TAB____TAB__info.destination.String(),
+__TAB____TAB____TAB__info.isTCP,
+__TAB____TAB____TAB__d.isConfiguredDNSServer(info.destination),
+__TAB____TAB____TAB__info.fragmented,
+__TAB____TAB__)
+__TAB____TAB__if !block {
+__TAB____TAB____TAB__packets[kept] = packet
+__TAB____TAB____TAB__kept++
+__TAB____TAB____TAB__continue
+__TAB____TAB__}
+
+__TAB____TAB__if !info.isTCP && !info.fragmented {
+__TAB____TAB____TAB__response := d.appCtx.BlockedDNSResponse(info.query)
+__TAB____TAB____TAB__if replyPacket := buildDNSReplyPacket(info, response); len(replyPacket) > 0 {
+__TAB____TAB____TAB____TAB__if err := d.injectPacket(dev, replyPacket); err != nil {
+__TAB____TAB____TAB____TAB____TAB__log.Printf("Tailscale DNS firewall blocked a query but could not inject its REFUSED response: %v", err)
+__TAB____TAB____TAB____TAB__}
+__TAB____TAB____TAB__}
+__TAB____TAB__}
+__TAB__}
+__TAB__return kept
+}
+
+func parseDNSPacket(packet []byte) (dnsPacketInfo, bool) {
+__TAB__if len(packet) == 0 {
+__TAB____TAB__return dnsPacketInfo{}, false
+__TAB__}
+__TAB__switch packet[0] >> 4 {
+__TAB__case 4:
+__TAB____TAB__return parseIPv4DNSPacket(packet)
+__TAB__case 6:
+__TAB____TAB__return parseIPv6DNSPacket(packet)
+__TAB__default:
+__TAB____TAB__return dnsPacketInfo{}, false