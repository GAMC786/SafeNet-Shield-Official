+__TAB____TAB__packet[32] = 0x50
+__TAB____TAB__packet[33] = 0x02 // SYN
+__TAB____TAB__return packet
+__TAB__}
+__TAB__binary.BigEndian.PutUint16(packet[20:22], 53000)
+__TAB__binary.BigEndian.PutUint16(packet[22:24], dnsPort)
+__TAB__binary.BigEndian.PutUint16(packet[24:26], uint16(8+len(query)))
+__TAB__if len(query) > 0 {
+__TAB____TAB__copy(packet[28:], query)
+__TAB__}
+__TAB__if response && len(query) >= 4 {
