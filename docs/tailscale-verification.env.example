# Tailscale hosted tailnet selected in the admin console.
TAILSCALE_TAILNET=-

# SafeNet's protected device-status adapter.
TAILSCALE_STATUS_URL=https://<published-safenet-host>/api/tailscale/device-status

# Never commit populated values. Store these in the protected runner/secrets flow.
TAILSCALE_STATUS_TOKEN=<separate-safenet-device-status-bearer-token>

TAILSCALE_ANDROID_PACKAGE=com.tailscale.ipn
TAILSCALE_ANDROID_DEVICE_NAME=<enrolled-android-device-name>
TAILSCALE_PEER_ADDRESS=<approved-tailscale-peer-ip-or-hostname>
TAILSCALE_ANDROID_TAILNET_CONFIRMED=pass

# Optional when more than one Android device is attached.
# TAILSCALE_ANDROID_SERIAL=<adb-device-serial>
# TAILSCALE_ANDROID_VPN_INTERFACE=<tailscale-interface-name>
# TAILSCALE_ANDROID_MESH_OUTPUT_DIR=android/app/build/reports/tailscale-android-mesh/latest