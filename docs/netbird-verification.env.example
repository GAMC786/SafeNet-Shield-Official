# Public root of the self-hosted NetBird management API.
NETBIRD_MANAGEMENT_URL=https://mesh.example.com
NETBIRD_DASHBOARD_URL=https://mesh.example.com

# Never commit populated values. Put these in the runner/workspace secrets flow.
NETBIRD_API_TOKEN=<dedicated-read-only-netbird-api-token>
NETBIRD_STATUS_TOKEN=<separate-safenet-peer-status-bearer-token>
NETBIRD_STATUS_URL=https://safenet.example.com/api/netbird/peer-status

NETBIRD_ANDROID_CLIENT_PACKAGE=io.netbird.client
NETBIRD_ANDROID_PEER_NAME=safenet-phone
NETBIRD_ANDROID_PEER_ADDRESS=<approved-peer-ip-or-hostname>
NETBIRD_ANDROID_MANAGEMENT_URL_CONFIRMED=pass
NETBIRD_PERSISTENT_STATE_CONFIRMED=pass

# Optional when more than one Android device is attached.
# NETBIRD_ANDROID_SERIAL=<adb-device-serial>
# NETBIRD_ANDROID_VPN_INTERFACE=<netbird-interface-name>
# NETBIRD_ANDROID_MESH_OUTPUT_DIR=android/app/build/reports/netbird-android-mesh/latest